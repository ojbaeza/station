# Station Environment Configuration

APP_NAME=Station
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# ===========================================
# Database (Job History Storage)
# ===========================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=station
DB_USERNAME=station
DB_PASSWORD=station

# ===========================================
# Queue Driver Selection
# ===========================================
# Use 'station' as the queue connection. Station reads driver config from config/station.php
# Available drivers: rabbitmq (Phase 1.0), redis, sqs, beanstalkd, kafka (Phase 2.x)
QUEUE_CONNECTION=station

# ===========================================
# RabbitMQ Configuration (Phase 1.0)
# ===========================================
# ⚠️ SECURITY: Default credentials are for development only!
# In production, use strong, unique values for RABBITMQ_USER and RABBITMQ_PASSWORD
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=your-rabbitmq-username
RABBITMQ_PASSWORD=your-secure-password
RABBITMQ_VHOST=station
# Exchange configuration (station.direct for jobs, station.dlx for dead letters)
RABBITMQ_EXCHANGE=station.direct
RABBITMQ_EXCHANGE_TYPE=direct

# ===========================================
# Redis Configuration (Phase 2.1)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis
REDIS_PREFIX=station_

# ===========================================
# AWS SQS/SNS Configuration (Phase 2.2)
# ===========================================
# LocalStack development only — replace with real credentials in production
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
SQS_PREFIX=http://localstack:4566/000000000000
SQS_QUEUE=station-default
SQS_ENDPOINT=http://localstack:4566

# ===========================================
# Beanstalkd Configuration (Phase 2.3)
# ===========================================
BEANSTALKD_HOST=beanstalkd
BEANSTALKD_PORT=11300
BEANSTALKD_QUEUE=default
BEANSTALKD_RETRY_AFTER=90
BEANSTALKD_BLOCK_FOR=0

# ===========================================
# Kafka Configuration (Phase 2.4)
# ===========================================
KAFKA_BROKERS=kafka:29092
KAFKA_GROUP_ID=station-workers
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true

# ===========================================
# Station Settings
# ===========================================
STATION_METRICS_ENABLED=true
STATION_METRICS_DRIVER=database
STATION_DASHBOARD_ENABLED=true
STATION_DASHBOARD_PATH=station
STATION_CHECKPOINT_ENABLED=true
# Checkpoint storage driver: database, redis, cache
STATION_CHECKPOINT_STORAGE=database
STATION_HEALTH_CHECK_INTERVAL=60

# ===========================================
# Worker Settings
# ===========================================
STATION_WORKER_TIMEOUT=60
STATION_WORKER_MEMORY=128
STATION_WORKER_MAX_JOBS=1000
STATION_WORKER_MAX_TIME=3600

# ===========================================
# Security Settings
# ===========================================
# API Authentication
# ⚠️ REQUIRED: Set a secure token for API access. Endpoints return 401 without this.
STATION_API_AUTH=token
STATION_API_TOKEN=your-secure-api-token

# Audit Logging
STATION_AUDIT_ENABLED=true
STATION_AUDIT_DRIVER=database
STATION_AUDIT_RETENTION_DAYS=90

# Checkpoint Security
# ⚠️ RECOMMENDED: Enable encryption to protect sensitive job state at rest
# Disable only for debugging. May have minor performance impact.
STATION_CHECKPOINT_ENCRYPT=true
STATION_CHECKPOINT_COMPRESSION=false

# Security Headers (enabled by default)
STATION_SECURITY_HEADERS=true

# Sensitive Data Masking (enabled by default)
# Note: Masking only hides data in dashboard/logs, NOT storage. Use encryption for at-rest protection.
STATION_MASKING_ENABLED=true

# ===========================================
# Alerting Configuration
# ===========================================
STATION_ALERTS_ENABLED=false
STATION_ALERT_SLACK_WEBHOOK=
STATION_ALERT_EMAIL=

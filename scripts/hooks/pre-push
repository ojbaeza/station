#!/bin/sh
#
# Pre-push hook: Run tests (same as CI)

set -e

echo "🚀 Running pre-push checks..."
echo ""

# Check if Docker container is running
if ! docker ps --format '{{.Names}}' | grep -q '^station_php$'; then
    echo "❌ Error: station_php container is not running"
    echo "   Run: docker compose up -d"
    exit 1
fi

# 1. Security Audit
echo "🔒 [1/3] Running security audit..."
if ! docker exec station_php sh -c "composer audit --no-interaction"; then
    echo ""
    echo "❌ Security vulnerabilities found. Please review and fix them."
    exit 1
fi
echo "✅ Security audit passed"
echo ""

# 2. PHPUnit Tests
echo "🧪 [2/3] Running PHPUnit tests..."
if ! docker exec station_php sh -c "XDEBUG_MODE=off ./vendor/bin/phpunit --no-progress"; then
    echo ""
    echo "❌ Tests failed. Please fix them before pushing."
    exit 1
fi
echo "✅ PHPUnit tests passed"
echo ""

# 3. Browser Tests (Pest + Playwright)
echo "🌐 [3/3] Running browser tests..."
if docker exec station_php sh -c "test -d tests/Browser"; then
    if ! docker exec station_php sh -c "XDEBUG_MODE=off ./vendor/bin/pest tests/Browser --no-progress"; then
        echo ""
        echo "❌ Browser tests failed. Please fix them before pushing."
        exit 1
    fi
    echo "✅ Browser tests passed"
else
    echo "⏭️  Browser tests skipped (tests/Browser not found)"
fi
echo ""

echo "✅ All pre-push checks passed! Safe to push."
